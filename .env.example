# ============================================================================
# TripSync Environment Configuration Template (.env.example)
# NEVER commit real secrets or private API keys to version control!
# ============================================================================

# PostgreSQL + PostGIS
POSTGRES_DB=tripsync
POSTGRES_USER=tripsync
POSTGRES_PASSWORD=replace_with_strong_db_password

# Redis Presence & Location Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT & OAuth 2.0 Authentication
JWT_SECRET=replace_with_64_byte_base64_encoded_secret_key
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Google Maps Platform (Restrict keys by HTTP referrer / IP in Google Cloud Console)
VITE_GOOGLE_MAPS_PUBLIC_KEY=your_restricted_browser_maps_key
GOOGLE_MAPS_SERVER_API_KEY=your_server_side_places_directions_geocoding_key

# AWS S3 / Cloudinary Media Storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=tripsync-media-prod
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Firebase Cloud Messaging (Push Notifications)
FCM_PROJECT_ID=tripsync-prod
FCM_SERVICE_ACCOUNT_JSON_PATH=/etc/tripsync/fcm-service-account.json
